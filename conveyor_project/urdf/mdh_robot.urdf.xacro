<?xml version="1.0"?>
<robot name="mdh_robot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ================================================== -->
  <!-- INCLUDES                                           -->
  <!-- ================================================== -->

  <xacro:include filename="$(find conveyor_project)/urdf/mdh_robot_control.gazebo.xacro"/>
  <xacro:include filename="$(find conveyor_project)/urdf/epick.urdf.xacro"/>

  <!--
    MODIFIED DH

    T = Tx(a) * Rx(alpha) * Rz(theta) * Tz(d)

    i     a       d       alpha
    1     0       0.20    0
    2     0       0       pi/2
    3    -0.60    0       0
    4    -0.60    0       pi/2
    5     0       0.20   -pi/2
    6     0       0.10    pi/2
  -->

  <!-- ================================================== -->
  <!-- MATERIALS                                          -->
  <!-- ================================================== -->

  <material name="blue">
    <color rgba="0.12 0.38 0.82 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.18 0.20 0.24 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.55 0.58 0.62 1.0"/>
  </material>

  <!-- ================================================== -->
  <!-- HELPER MACROS                                      -->
  <!-- ================================================== -->

  <xacro:macro name="body" params="name mass">
    <link name="${name}">
      <inertial>
        <mass value="${mass}"/>
        <inertia
          ixx="0.01" ixy="0" ixz="0"
          iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="motor" params="name radius">
    <link name="${name}">

      <visual>
        <geometry>
          <cylinder radius="${radius}" length="0.10"/>
        </geometry>
        <material name="dark"/>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="${radius}" length="0.10"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.8"/>
        <inertia
          ixx="0.004" ixy="0" ixz="0"
          iyy="0.004" iyz="0" izz="0.004"/>
      </inertial>

    </link>
  </xacro:macro>

  <xacro:macro name="z_connector" params="name parent length radius">

    <xacro:if value="${length > 0.001}">

      <link name="${name}">

        <visual>
          <origin xyz="0 0 ${length/2}" rpy="0 0 0"/>
          <geometry>
            <cylinder radius="${radius}" length="${length}"/>
          </geometry>
          <material name="blue"/>
        </visual>

        <inertial>
          <origin xyz="0 0 ${length/2}"/>
          <mass value="0.2"/>
          <inertia
            ixx="0.001" ixy="0" ixz="0"
            iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>

      </link>

      <joint name="${name}_fixed" type="fixed">
        <parent link="${parent}"/>
        <child link="${name}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>

    </xacro:if>

  </xacro:macro>

  <!-- ================================================== -->
  <!-- MODIFIED DH JOINT                                  -->
  <!-- ================================================== -->

  <xacro:macro name="mdh_joint" params="i parent a d alpha">

    <xacro:body name="pre_${i}" mass="0.01"/>

    <joint name="pre_joint_${i}" type="fixed">
      <parent link="${parent}"/>
      <child link="pre_${i}"/>
      <origin xyz="${a} 0 0" rpy="${alpha} 0 0"/>
    </joint>

    <xacro:motor name="axis_${i}" radius="0.065"/>

    <joint name="joint_${i}" type="revolute">
      <parent link="pre_${i}"/>
      <child link="axis_${i}"/>

      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>

      <limit
        lower="${-2*pi}"
        upper="${2*pi}"
        effort="150"
        velocity="2.0"/>

      <dynamics damping="1.0" friction="0.1"/>
    </joint>

    <xacro:z_connector
      name="connector_${i}"
      parent="axis_${i}"
      length="${d}"
      radius="0.035"/>

    <xacro:body name="link_${i}" mass="0.5"/>

    <joint name="post_joint_${i}" type="fixed">
      <parent link="axis_${i}"/>
      <child link="link_${i}"/>
      <origin xyz="0 0 ${d}" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

  <!-- ================================================== -->
  <!-- WORLD AND BASE                                     -->
  <!-- ================================================== -->

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!--
    Base diameter: 440 mm
    Base height:   500 mm

    With spawn-z = 0.375 m,
    bottom of base is at ground level.
  -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.22" length="0.50"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0 0 -0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.22" length="0.50"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.125"/>
      <mass value="35.0"/>
      <inertia
        ixx="0.94" ixy="0" ixz="0"
        iyy="0.94" iyz="0"
        izz="0.42"/>
    </inertial>

  </link>

  <!-- ================================================== -->
  <!-- JOINT 1 - BASE ROTATION                             -->
  <!-- ================================================== -->

  <xacro:mdh_joint
    i="1"
    parent="base_link"
    a="0"
    d="0.20"
    alpha="0"/>

  <!-- Rotating base column -->

  <link name="base_motor_mount">

    <visual>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.095" length="0.18"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <inertial>
      <origin xyz="0 0 -0.09"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.002" ixy="0" ixz="0"
        iyy="0.002" iyz="0"
        izz="0.002"/>
    </inertial>

  </link>

  <joint name="base_motor_mount_fixed" type="fixed">
    <parent link="link_1"/>
    <child link="base_motor_mount"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================== -->
  <!-- JOINT 2 - SHOULDER                                  -->
  <!-- ================================================== -->

  <xacro:mdh_joint
    i="2"
    parent="link_1"
    a="0"
    d="0"
    alpha="${pi/2}"/>

  <!-- First arm: 600 mm -->

  <link name="upper_arm">

    <visual>
      <origin xyz="-0.30 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.09 0.09"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="-0.30 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.09 0.09"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.30 0 0"/>
      <mass value="3.0"/>
      <inertia
        ixx="0.004" ixy="0" ixz="0"
        iyy="0.09" iyz="0"
        izz="0.09"/>
    </inertial>

  </link>

  <joint name="upper_arm_fixed" type="fixed">
    <parent link="link_2"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================== -->
  <!-- JOINT 3 - ELBOW                                     -->
  <!-- ================================================== -->

  <xacro:mdh_joint
    i="3"
    parent="link_2"
    a="-0.60"
    d="0"
    alpha="0"/>

  <!-- Second arm: 600 mm -->

  <link name="forearm">

    <visual>
      <origin xyz="-0.30 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.075 0.075"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="-0.30 0 0"/>
      <geometry>
        <box size="0.60 0.075 0.075"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="-0.30 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.003" ixy="0" ixz="0"
        iyy="0.06" iyz="0"
        izz="0.06"/>
    </inertial>

  </link>

  <joint name="forearm_fixed" type="fixed">
    <parent link="link_3"/>
    <child link="forearm"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================== -->
  <!-- JOINTS 4, 5, 6 - WRIST                              -->
  <!-- ================================================== -->

  <xacro:mdh_joint
    i="4"
    parent="link_3"
    a="-0.60"
    d="0"
    alpha="${pi/2}"/>

  <xacro:mdh_joint
    i="5"
    parent="link_4"
    a="0"
    d="0.20"
    alpha="${-pi/2}"/>

  <xacro:mdh_joint
    i="6"
    parent="link_5"
    a="0"
    d="0.10"
    alpha="${pi/2}"/>

  <!-- ================================================== -->
  <!-- ROBOTIQ EPICK FOUR-CUP VACUUM GRIPPER              -->
  <!-- ================================================== -->

  <!--
    The epick macro creates:
      epick_link
      epick_joint
      tcp_link
      tcp_joint
  -->

  <xacro:epick parent="link_6"/>

  <!-- Keep tool0 as an alias of the gripper TCP -->

  <link name="tool0"/>

  <joint name="tool0_joint" type="fixed">
    <parent link="tcp_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================================================== -->
  <!-- GAZEBO VACUUM ATTACH / DETACH                       -->
  <!-- ================================================== -->

  <gazebo>

    <plugin
      filename="gz-sim-detachable-joint-system"
      name="gz::sim::systems::DetachableJoint">

      <parent_link>epick_link</parent_link>

      <!-- These names must match the Gazebo package model -->
      <child_model>package</child_model>
      <child_link>package_link</child_link>

      <detach_topic>/vacuum/detach</detach_topic>
      <attach_topic>/vacuum/attach</attach_topic>
      <output_topic>/vacuum/state</output_topic>

    </plugin>

  </gazebo>

</robot>
