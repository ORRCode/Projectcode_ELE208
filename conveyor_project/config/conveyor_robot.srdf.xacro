<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur">

  <!-- MoveIt planning group -->
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="tcp_link"/>
  </group>

  <!-- Robot starting position -->
  <group_state name="home" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="0.0"/>
    <joint name="shoulder_lift_joint" value="-1.2"/>
    <joint name="elbow_joint" value="1.2"/>
    <joint name="wrist_1_joint" value="-1.5"/>
    <joint name="wrist_2_joint" value="1.0"/>
    <joint name="wrist_3_joint" value="0.0"/>
  </group_state>

  <!-- Ignore collisions between adjacent robot links -->
  <disable_collisions
    link1="base_link_inertia"
    link2="shoulder_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="upper_arm_link"
    link2="forearm_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="forearm_link"
    link2="wrist_1_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="wrist_1_link"
    link2="wrist_2_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="wrist_2_link"
    link2="wrist_3_link"
    reason="Adjacent"/>

  <!-- Tool and gripper -->
  <disable_collisions
    link1="tool0"
    link2="epick_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="tool0"
    link2="tcp_link"
    reason="Adjacent"/>

  <disable_collisions
    link1="wrist_3_link"
    link2="epick_link"
    reason="Adjacent"/>

</robot>
